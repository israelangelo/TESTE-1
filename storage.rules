rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // ── Check-in fachada ─────────────────────────────────────────────────
    // Promotor só grava na própria pasta: checkins/{uid}/...
    match /checkins/{uid}/{allPaths=**} {
      allow read:  if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // ── Fotos PDV ────────────────────────────────────────────────────────
    // Promotor só grava na própria pasta: fotos_pdv/{uid}/...
    match /fotos_pdv/{uid}/{allPaths=**} {
      allow read:  if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // ── Bloqueia tudo o mais ─────────────────────────────────────────────
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
